# PhishGuard AI - Environment Configuration

# Backend Settings
APP_NAME=PhishGuard AI
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Threat Intelligence API Keys
# Free tier keys can be obtained from virustotal.com and cloud.google.com
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=

# Optional Supabase Database & Auth (Leave blank for SQLite local mode)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Frontend Settings (Used in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_URL=https://github.com/example/phishguard-ai
